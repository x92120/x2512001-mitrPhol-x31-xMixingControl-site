    {
        "id": "sim_plant2",
        "type": "function",
        "z": "plant_monitor_tab",
        "name": "Simulate Plant 2",
        "func": "const step = context.get('step') || 1;\nlet timer = context.get('timer') || 0;\ntimer += 2;\nif (timer >= 60) {\n    timer = 0;\n}\ncontext.set('timer', timer);\n\n// realistic curves\nconst vol = 120 + Math.sin(Date.now() / 60000) * 15;\nconst temp = 62 + Math.cos(Date.now() / 120000) * 2;\nconst agit = 1500;\n\nmsg.payload = {\n    \"Step_no\": step,\n    \"Step_Timer\": timer,\n    \"Mixing_Tank_Volume\": Number(vol.toFixed(2)),\n    \"Mixing_Tank_Temperature\": Number(temp.toFixed(2)),\n    \"MixingTank_Agitator_Speed\": agit,\n    \"HighShare_Speed\": 0,\n    \"watchdog\": Math.floor(Math.random() * 100),\n    \"PLC_State\": 1\n};\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 240,
        "wires": [
            [
                "mqtt_out_plant2"
            ]
        ]
    },
