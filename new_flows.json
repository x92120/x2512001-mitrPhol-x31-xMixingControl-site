    {
        "id": "e315db4265d34445",
        "type": "function",
        "z": "plant_monitor_tab",
        "name": "Parse CMD -> DB1530",
        "func": "const cmd = msg.payload;\nconst msgs = [];\nif (cmd.HMI_Command !== undefined) msgs.push({ payload: Number(cmd.HMI_Command), variable: \"HMI_Command\" });\nif (cmd.Step_ID !== undefined) msgs.push({ payload: Number(cmd.Step_ID), variable: \"Step_ID\" });\nif (cmd.TT_SP !== undefined) msgs.push({ payload: Number(cmd.TT_SP[0] || 0), variable: \"TT_SP\" });\nif (cmd.Agitator_Speed !== undefined) msgs.push({ payload: Number(cmd.Agitator_Speed), variable: \"Agitator_Speed\" });\nif (cmd.High_Shear_SP !== undefined) msgs.push({ payload: Number(cmd.High_Shear_SP), variable: \"High_Shear_SP\" });\nif (cmd.Step_Time_SP !== undefined) msgs.push({ payload: Number(cmd.Step_Time_SP), variable: \"Step_Time_SP\" });\nif (cmd.Cmd_NewStep !== undefined) msgs.push({ payload: Boolean(cmd.Cmd_NewStep), variable: \"Cmd_NewStep\" });\nreturn [msgs];",
        "outputs": 1,
        "x": 380,
        "y": 400,
        "wires": [
            [
                "47c3299871cf42a3"
            ]
        ]
    },
