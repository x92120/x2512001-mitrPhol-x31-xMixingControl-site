{
  "annotations": { "list": [ { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" } ] },
  "editable": true, "fiscalYearStartMonth": 0, "graphTooltip": 1, "links": [], "liveNow": false,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Current Step ID",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "query": "from(bucket: \"SPP\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"topic\"] =~ /.*MIX-03.*/ or r[\"topic\"] =~ /.*plant\\/3.*/) |> filter(fn: (r) => r[\"_field\"] =~ /.*Current_Step.*/ or r[\"_field\"] =~ /.*Step_No.*/) |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "id": 1,
      "title": "Current Tank Volume",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "query": "from(bucket: \"SPP\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"topic\"] =~ /.*MIX-03.*/ or r[\"topic\"] =~ /.*plant\\/3.*/)\n  |> filter(fn: (r) => r[\"_field\"] =~ /.*MixTank_Weight.*/ or r[\"_field\"] =~ /.*Mixing_Tank_Volume.*/ or r[\"_field\"] =~ /.*Scale_Act.*/)\n  |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "masskg", "min": 0, "max": 1500, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1400 } ] } } }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "id": 2,
      "title": "Current Temperature",
