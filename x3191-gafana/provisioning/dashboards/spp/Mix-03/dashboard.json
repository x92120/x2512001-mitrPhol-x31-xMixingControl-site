      "targets": [
        {
          "query": "from(bucket: \"SPP\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"topic\"] =~ /.*MIX-03.*/ or r[\"topic\"] =~ /.*plant\\/3.*/)\n  |> filter(fn: (r) => r[\"_field\"] =~ /.*MixTank_Temp.*/ or r[\"_field\"] =~ /.*Mixing_Tank_Temperature.*/ or r[\"_field\"] =~ /.*Temp_Act.*/)\n  |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "celsius", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 85 } ] } } }
