    {
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "title": "Plant 3 Process Overview (Combined Trends)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "query": "from(bucket: \"SPP\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"topic\"] =~ /.*MIX-03.*/ or r[\"topic\"] =~ /.*plant\\/3.*/)\n  |> filter(fn: (r) => r[\"_field\"] =~ /.*MixTank_Weight.*/ or r[\"_field\"] =~ /.*Mixing_Tank_Volume.*/ or r[\"_field\"] =~ /.*Scale_Act.*/ or r[\"_field\"] =~ /.*MixTank_Temp.*/ or r[\"_field\"] =~ /.*Mixing_Tank_Temperature.*/ or r[\"_field\"] =~ /.*Temp_Act.*/ or r[\"_field\"] =~ /.*Agitator_Act.*/ or r[\"_field\"] =~ /.*MixingTank_Agitator_Speed.*/ or r[\"_field\"] =~ /.*HighShear_Act.*/ or r[\"_field\"] =~ /.*HighShare_Speed.*/ or r[\"_field\"] =~ /.*Current_Step.*/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "lineWidth": 2 },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/.*Step.*/" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "white" } },
              { "id": "custom.drawStyle", "value": "stepAfter" },
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.*Volume|Weight|Scale.*/" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "cyan" } },
              { "id": "unit", "value": "masskg" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1500 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.*Temp.*/" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "unit", "value": "celsius" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.*Agitator.*/" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } },
              { "id": "unit", "value": "rotrpm" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.*High.*/" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } },
              { "id": "unit", "value": "rotrpm" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 2000 },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
