      "id": 4,
      "title": "Current High Share",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "query": "from(bucket: \"SPP\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"topic\"] =~ /.*MIX-03.*/ or r[\"topic\"] =~ /.*plant\\/3.*/)\n  |> filter(fn: (r) => r[\"_field\"] =~ /.*HighShear_Act.*/ or r[\"_field\"] =~ /.*HighShare_Speed.*/)\n  |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rotrpm", "min": 0, "max": 2000, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "purple", "value": 1800 } ] } } }
