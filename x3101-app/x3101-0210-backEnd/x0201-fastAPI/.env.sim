# ============================================================
#  xMixing SIM Backend .env — PLCSIM Advanced V16
#  *** ไม่กระทบ Production (port 8031) ***
# ============================================================

# Database — ใช้ DB เดียวกัน (read) หรือ test DB ก็ได้
DB_USER=mixingcontrol
DB_PASSWORD=admin100
DB_HOST=192.168.121.11
DB_PORT=3306
DB_NAME=xMixingControl

# JWT
SECRET_KEY=sim-secret-key-for-testing-only-32-chars

# CORS
ALLOWED_ORIGINS=http://localhost:3032,http://localhost:5173,http://192.168.21.198:3032

# PLC — ชี้ไป PLCSIM Advanced V16
PLC_IP=192.168.21.220

# SIM Flag
SIM_MODE=true

# MQTT Topic Prefix — แยก topic SIM ออกจาก Production
# Production uses: mixing/plant/+/telemetry
# SIM uses:       SIM/mixing/plant/+/telemetry
MQTT_TOPIC_PREFIX=SIM/
