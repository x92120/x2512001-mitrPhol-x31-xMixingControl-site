    {
        "id": "e315db4265d34445",
        "type": "function",
        "z": "plant_monitor_tab",
        "name": "Parse CMD -> DB1530",
        "func": "const cmd = msg.payload;\nconst pfx = 'p3_';\nconst pairs = [];\n\n// String fields\nif (cmd.Batch_ID  !== undefined) pairs.push([pfx+'Batch_ID',      String(cmd.Batch_ID)]);\nif (cmd.Phase_ID  !== undefined) pairs.push([pfx+'Phase_ID',      String(cmd.Phase_ID)]);\nif (cmd.Re_Code_ID!== undefined) pairs.push([pfx+'Re_Code',       String(cmd.Re_Code_ID)]);\n\n// Numeric fields\nconst reqQty = cmd.Req_Qty ?? cmd.Target_Weight ?? cmd.require;\nif (reqQty  !== undefined && reqQty !== null) pairs.push([pfx+'Target_Weight', Number(reqQty)]);\nif (cmd.HMI_Command    !== undefined) pairs.push([pfx+'HMI_Command',   Number(cmd.HMI_Command)]);\nif (cmd.Step_ID        !== undefined) pairs.push([pfx+'Step_ID',        Number(cmd.Step_ID)]);\nif (cmd.TT_SP          !== undefined) pairs.push([pfx+'TT_SP',          Number(Array.isArray(cmd.TT_SP) ? cmd.TT_SP[0] : cmd.TT_SP)]);\nif (cmd.Agitator_Speed !== undefined) pairs.push([pfx+'Agitator_Speed', Number(cmd.Agitator_Speed)]);\nif (cmd.High_Shear_SP  !== undefined) pairs.push([pfx+'High_Shear_SP',  Number(cmd.High_Shear_SP)]);\nif (cmd.Step_Time_SP   !== undefined) pairs.push([pfx+'Step_Time_SP',   Number(cmd.Step_Time_SP)]);\n\n// Bool/bit field — write last so PLC sees new step trigger after all setpoints are set\nif (cmd.Cmd_NewStep !== undefined) pairs.push([pfx+'Cmd_NewStep', Boolean(cmd.Cmd_NewStep)]);\n\n// s7 out requires ONE message per variable\npairs.forEach(([variable, payload]) => node.send({ variable, payload }));\nreturn null;",
        "outputs": 1,
        "x": 380,
        "y": 400,
        "wires": [
            [
                "47c3299871cf42a3"
            ]
        ]
    },
